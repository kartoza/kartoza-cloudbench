# The GeoHosting that starts the on-demand CloudNativeGIS servers, for the
# "Django: Run server (on demand)" launch configuration.
# Copy this file to .vscode/on-demand.env (git-ignored) and fill it in:
#   cp .vscode/on-demand.env.example .vscode/on-demand.env
#
# GeoHosting's URL, and the client id/secret of its OAuth "Client credentials"
# Application - the one whose client id is GeoHosting's CLOUDBENCH_OAUTH_CLIENT_ID.
GEOHOSTING_URL=
GEOHOSTING_CLIENT_ID=
GEOHOSTING_CLIENT_SECRET=
# Not needed in development: without it CloudBench uses its development key. Setting
# another one makes the S3 connections saved with the default unreadable.
# CLOUDBENCH_ENCRYPTION_KEY=
