{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Run server",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8080"],
      "django": true,
      "justMyCode": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "cloudbench.settings.development",
        "CLOUDNATIVEGIS_URL": "http://127.0.0.1:8100"
      }
    },
    {
      "name": "Django: Run server (on demand)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8080"],
      "django": true,
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.vscode/on-demand.env",
      "env": {
        "DJANGO_SETTINGS_MODULE": "cloudbench.settings.development",
        "CLOUDNATIVEGIS_ON_DEMAND": "True",
        "CLOUDNATIVEGIS_BULK_MAX_SERVERS": "5"
      }
    },
    {
      "name": "Vite Dev Server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 0.0.0.0",
      "cwd": "${workspaceFolder}/web",
      "env": {
        "VITE_API_PROXY_TARGET": "http://127.0.0.1:8080"
      }
    }
  ],
  "compounds": [
    {
      "name": "Django + Vite",
      "configurations": ["Django: Run server", "Vite Dev Server"],
      "stopAll": true
    },
    {
      "name": "Django (on demand) + Vite",
      "configurations": ["Django: Run server (on demand)", "Vite Dev Server"],
      "stopAll": true
    }
  ]
}
