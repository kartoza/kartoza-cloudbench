# Settings for the staging test suite (tests/staging/).
#
#   cp .env.staging.example .env.staging   # .env.staging is git-ignored
#
# Fill in the values. Leave a value blank to skip the tests that need it.
# Booleans are true/false. Never commit .env.staging.

# ---------------------------------------------------------------------------
# 1. CloudBench staging
# ---------------------------------------------------------------------------

# Base URL, without a trailing slash. The API is under {URL}/api/.
STAGING_CLOUDBENCH_URL=https://cloudbench.staging.example.com

# How the tests log in. Use ONE of these two:
#
#  a) A DRF token (recommended). It works for SSO users who have no password.
#     Create it in Django admin (Auth Token → Tokens → Add, pick the user) or
#     with `python manage.py drf_create_token <username>`.
STAGING_CLOUDBENCH_TOKEN=
#  b) A username and password (POST /api/auth/login/).
STAGING_CLOUDBENCH_USERNAME=
STAGING_CLOUDBENCH_PASSWORD=
#
# For the on-demand tests, this user must ALSO exist in GeoHosting under the
# same username. Otherwise GeoHosting refuses the server (400). The user you
# bought the instances with is the safest choice.

# Prefix for everything the tests create (connections, tables, layers,
# objects in the bucket), so it can be found and cleaned up. S3 is the
# exception: nothing there is ever deleted (see STAGING_S3_PREFIX).
STAGING_TEST_PREFIX=cbtest_

# true = keep what the tests created, to look at it by hand afterwards.
STAGING_KEEP_ARTIFACTS=false

# true = show the browser while tests/staging runs (default: headless).
STAGING_HEADED=false

# ---------------------------------------------------------------------------
# 2. Instances bought on GeoHosting (already added to CloudBench)
# ---------------------------------------------------------------------------
# GeoHosting adds them with the id "geohosting_<instance id>". The tests only
# use them and never delete them. Leave blank and the tests pick the first
# geohosting_* connection of each type.

STAGING_GH_GEOSERVER_CONNECTION_ID=
STAGING_GH_GEONODE_CONNECTION_ID=
STAGING_GH_POSTGIS_SERVICE_ID=

# ---------------------------------------------------------------------------
# 3. Manually added connections
# ---------------------------------------------------------------------------
# The tests create a connection from these values the way the "Add …" dialog
# does, upload to it, then delete the connection. It can be the same server
# as a GeoHosting instance above (copy its credentials from GeoHosting).

# --- GeoServer ---
STAGING_GEOSERVER_URL=https://geoserver.staging.example.com/geoserver
STAGING_GEOSERVER_USERNAME=admin
STAGING_GEOSERVER_PASSWORD=
# Workspace the tests upload into. It is created if missing, and can be
# deleted at cleanup if the tests created it.
STAGING_GEOSERVER_WORKSPACE=cbtest

# --- GeoNode ---
STAGING_GEONODE_URL=https://geonode.staging.example.com
# Use a username + password, OR a token.
STAGING_GEONODE_USERNAME=admin
STAGING_GEONODE_PASSWORD=
STAGING_GEONODE_TOKEN=

# --- PostGIS ---
STAGING_POSTGIS_HOST=
STAGING_POSTGIS_PORT=5432
STAGING_POSTGIS_DBNAME=
STAGING_POSTGIS_USER=
STAGING_POSTGIS_PASSWORD=
# disable | allow | prefer | require | verify-ca | verify-full
STAGING_POSTGIS_SSLMODE=require
# Schema the tests import into. It is created if missing.
STAGING_POSTGIS_SCHEMA=cbtest

# --- S3 ---
# Endpoint without the scheme, e.g. s3.eu-central-1.amazonaws.com or
# fsn1.your-objectstorage.com (Hetzner).
STAGING_S3_ENDPOINT=
STAGING_S3_BUCKET=
STAGING_S3_ACCESS_KEY=
STAGING_S3_SECRET_KEY=
STAGING_S3_REGION=
STAGING_S3_USE_SSL=true
STAGING_S3_PATH_STYLE=false
# Folder in the bucket for the test uploads. The tests NEVER delete anything
# in S3, not even their own uploads: clean up by hand if needed.
STAGING_S3_PREFIX=cbtest/
STAGING_S3_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# 4. S3 conversions, on-demand (each job starts a real Hetzner server)
# ---------------------------------------------------------------------------

# false = skip every test that starts a server.
STAGING_ONDEMAND_ENABLED=true

# Hetzner server type to use, by GeoHosting's HetznerServer id (the
# "hetznerServerId" in the upload dialog). Blank = the cheapest one in stock.
STAGING_ONDEMAND_HETZNER_SERVER_ID=

# Cost cap: at most this many on-demand jobs (= servers) per run. A test that
# would go over it is skipped. A full run needs about 8.
STAGING_ONDEMAND_MAX_JOBS=3

# Longest the tests wait for one conversion, start to finish, including
# starting and deleting the server. CloudBench itself has no such limit, so
# without it a stuck job would hang the run.
STAGING_JOB_TIMEOUT_SECONDS=1800

# true = also run the cancel/restart tests with the large files
# (manual-test-data/large/, made by `generate.py --large`).
STAGING_RUN_LARGE=false
