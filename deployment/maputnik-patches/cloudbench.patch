+  // CloudBench integration: when opened from CloudBench's "Edit style" with
+  // ?cbConnectionId=&cbBucket=&cbStyleKey=, the "Save" button saves straight
+  // to that S3 bucket instead of opening the normal export dialog. Same
+  // origin as CloudBench, so the auth token in localStorage just works.
+  handleSaveClick = () => {
+    const params = new URLSearchParams(window.location.search);
+    const connectionId = params.get("cbConnectionId");
+    const bucket = params.get("cbBucket");
+    const key = params.get("cbStyleKey");
+
+    if (!connectionId || !bucket || !key) {
+      this.props.onToggleModal("export");
+      return;
+    }
+
+    const token = window.localStorage.getItem("token");
+    const blob = new Blob([JSON.stringify(this.props.mapStyle, null, 2)], {type: "application/json"});
+    const formData = new FormData();
+    formData.append("file", blob, key.split("/").pop() || "style.json");
+    formData.append("key", key);
+
+    fetch(`/api/s3/upload/${encodeURIComponent(connectionId)}/${encodeURIComponent(bucket)}`, {
+      method: "POST",
+      headers: token ? {Authorization: `Token ${token}`} : {},
+      body: formData,
+    }).then((res) => {
+      window.alert(res.ok ? "Style saved to bucket." : "Failed to save style.");
+    }).catch(() => {
+      window.alert("Failed to save style.");
+    });
+  };
+
   render() {
