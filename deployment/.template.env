# ============================================================
# Kartoza CloudBench — Environment Variables
# Copy to .env and fill in values before running docker compose
# ============================================================
COMPOSE_PROJECT_NAME=cloudbench
CLOUDBENCH_TAG=1.2.0
CLOUDBENCH_DATA_FOLDER=/home/web/cloudbench_data

# --- Django ---
DJANGO_SETTINGS_MODULE=cloudbench.settings.production
DJANGO_SECRET_KEY=DJANGO_SECRET_KEY
# Fernet key for encrypting stored credentials (required in production). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUDBENCH_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=*
SECURE_SSL_REDIRECT=false

# --- Gunicorn ---
GUNICORN_WORKERS=4

# --- CORS (production) ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com

CLOUDBENCH_SERVICE_TOKEN=
CLOUDBENCH_FRAME_ANCESTORS=
CLOUDBENCH_SSO_TOKEN_MAX_AGE=43200

# Redirect the frontend's "Add" button to an external URL instead of the
# built-in dialog, per connection type. Leave blank to use the dialog.
VITE_CREATE_GEOSERVER_URL=
VITE_CREATE_POSTGIS_URL=
VITE_CREATE_GEONODE_URL=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# --- Portolan catalog ---
# The "host" provider in each published layer's collection.json. Its URL is
# always the layer's bucket URL; the name defaults to the endpoint's
# hostname. The contact email is the S3 connection's own (set in its
# connection dialog), falling back to PORTOLAN_HOST_EMAIL.
PORTOLAN_HOST_NAME=
PORTOLAN_HOST_EMAIL=

# --- CloudNativeGIS processing ---
CLOUDNATIVEGIS_PROCESSING_TAG=0.0.4
CLOUDNATIVEGIS_URL=
CLOUDNATIVEGIS_CONVERSION_TIMEOUT=1800
CLOUDNATIVEGIS_POLL_INTERVAL=5
# Seconds a conversion waits for CloudNativeGIS to answer /health before failing.
CLOUDNATIVEGIS_PROVISIONING_TIMEOUT=300

# Max size (bytes) of a source file the service will download, default 500MB.
CLOUDNATIVEGIS_MAX_DOWNLOAD_SIZE=524288000
# Shared secret Django sends as a bearer token; also passed to the service
# as LITE_API_TOKEN. Empty disables auth.
CLOUDNATIVEGIS_API_TOKEN=
# Run CloudNativeGIS on demand per conversion job (servers started by
# GeoHosting, below) instead of CLOUDNATIVEGIS_URL.
CLOUDNATIVEGIS_ON_DEMAND=false
# GeoHosting, which runs those on-demand servers: its URL, and the client
# id/secret of an OAuth "Client credentials" Application there. Set the same
# client id as GeoHosting's CLOUDBENCH_OAUTH_CLIENT_ID: the only Application
# it gives the cloudbench scope.
GEOHOSTING_URL=
GEOHOSTING_CLIENT_ID=
GEOHOSTING_CLIENT_SECRET=
