# ============================================================
# Kartoza CloudBench — Environment Variables
# Copy to .env and fill in values before running docker compose
# ============================================================

# --- Admin ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# --- Django ---
DJANGO_SETTINGS_MODULE=cloudbench.settings.production
DJANGO_SECRET_KEY=DJANGO_SECRET_KEY
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Nginx ---
HTTP_PORT=80

# --- CloudBench ---
CLOUDBENCH_TAG=0.0.1

# Main data folder (mounted as a volume)
CLOUDBENCH_DATA_FOLDER=/home/web/cloudbench_data

# Encryption key for stored credentials
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLOUDBENCH_ENCRYPTION_KEY=

# --- Gunicorn ---
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# --- CORS (production) ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# --- GeoHosting integration (optional) ---
# Everything below is only needed if you're embedding this CloudBench
# instance inside a GeoHosting deployment (iframe SSO handoff + instance
# push-sync). Leave blank to run fully standalone — sign in with
# ADMIN_USERNAME/ADMIN_PASSWORD above at the app's own login screen and
# add GeoServer/GeoNode/PostGIS connections manually from there instead.
#
# Shared secret with GeoHosting's CLOUDBENCH_SERVICE_TOKEN. Gates
# /api/geohosting/* and is the HMAC key for SSO tokens — see
# apps/core/sso_auth.py.
CLOUDBENCH_SERVICE_TOKEN=
# Origins allowed to embed this app in an iframe (CSP frame-ancestors).
# Comma-separated, e.g. https://geohosting.example.com. Leave blank if
# you're not embedding this anywhere.
CLOUDBENCH_FRAME_ANCESTORS=
# How long a GeoHosting-issued SSO token stays valid, in seconds.
CLOUDBENCH_SSO_TOKEN_MAX_AGE=43200